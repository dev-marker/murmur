@base = http://localhost:8080

### Sign up
# @name alice
POST {{base}}/users
Content-Type: application/json

{ "handle": "alice" }

### The same handle again
# @name taken
POST {{base}}/users
Content-Type: application/json

{ "handle": "alice" }

### A second user
# @name bob
POST {{base}}/users
Content-Type: application/json

{ "handle": "bob" }

### Alice posts
# @name first
POST {{base}}/posts
Authorization: Bearer {{alice.response.body.token}}
Content-Type: application/json

{ "body": "hello, murmur" }

### And she posts again
# @name second
POST {{base}}/posts
Authorization: Bearer {{alice.response.body.token}}
Content-Type: application/json

{ "body": "one sitting, one social network" }

### A post without a token
# @name anonymous
POST {{base}}/posts
Content-Type: application/json

{ "body": "who am I?" }

### Alice's posts, newest first
# @name list
GET {{base}}/users/alice/posts

### A third user
# @name carol
POST {{base}}/users
Content-Type: application/json

{ "handle": "carol" }

### Carol follows alice
# @name follow
POST {{base}}/users/alice/follow
Authorization: Bearer {{carol.response.body.token}}

### And she follows bob
# @name followBob
POST {{base}}/users/bob/follow
Authorization: Bearer {{carol.response.body.token}}

### Nobody by that name
# @name nobody
POST {{base}}/users/dave/follow
Authorization: Bearer {{carol.response.body.token}}

### Carol unfollows bob
# @name unfollow
DELETE {{base}}/users/bob/follow
Authorization: Bearer {{carol.response.body.token}}

### Carol follows herself
# @name herself
POST {{base}}/users/carol/follow
Authorization: Bearer {{carol.response.body.token}}

### Bob posts
# @name third
POST {{base}}/posts
Authorization: Bearer {{bob.response.body.token}}
Content-Type: application/json

{ "body": "bob here, good morning" }

### Alice posts once more
# @name fourth
POST {{base}}/posts
Authorization: Bearer {{alice.response.body.token}}
Content-Type: application/json

{ "body": "somebody is listening now" }

### Bob posts while carol is reading
# @name late
POST {{base}}/posts
Authorization: Bearer {{bob.response.body.token}}
Content-Type: application/json

{ "body": "while you were reading" }

### Carol's home feed, page one
# @name page1
GET {{base}}/feed?limit=2
Authorization: Bearer {{carol.response.body.token}}

### Page two
# @name page2
GET {{base}}/feed?limit=2&cursor={{page1.response.body.next_cursor}}
Authorization: Bearer {{carol.response.body.token}}

### Page three
# @name page3
GET {{base}}/feed?limit=2&cursor={{page2.response.body.next_cursor}}
Authorization: Bearer {{carol.response.body.token}}

### A cursor that isn't a post id
# @name badCursor
GET {{base}}/feed?cursor=latest
Authorization: Bearer {{carol.response.body.token}}

### A seeded user's feed (after make seed)
# @name seeded
GET {{base}}/feed?limit=2
Authorization: Bearer seed-token-42

### A quiet account posts (it has 30 followers)
# @name quietPost
POST {{base}}/posts
Authorization: Bearer seed-token-16726
Content-Type: application/json

{ "body": "good morning from a quiet account" }

### One of its followers reads their feed
# @name follower
GET {{base}}/feed?limit=2
Authorization: Bearer seed-token-2000

### A reader who follows 199 accounts
# @name heavy
GET {{base}}/feed?limit=2
Authorization: Bearer seed-token-363

### The biggest account posts (it has 29,620 followers)
# @name bigPost
POST {{base}}/posts
Authorization: Bearer seed-token-1
Content-Type: application/json

{ "body": "hello, everybody" }

### The biggest account posts again
# @name bigAgain
POST {{base}}/posts
Authorization: Bearer seed-token-1
Content-Type: application/json

{ "body": "can anybody hear me?" }

### A follower of the biggest account reads their feed
# @name fan
GET {{base}}/feed?limit=2
Authorization: Bearer seed-token-739

### A quiet account posts while Redis refuses to write
# @name lost
POST {{base}}/posts
Authorization: Bearer seed-token-16726
Content-Type: application/json

{ "body": "is this thing on?" }

### It posts again, and no worker is running
# @name queued
POST {{base}}/posts
Authorization: Bearer seed-token-16726
Content-Type: application/json

{ "body": "this one waits for a worker" }

### And again, with Redis full and a worker running
# @name retried
POST {{base}}/posts
Authorization: Bearer seed-token-16726
Content-Type: application/json

{ "body": "Redis was full when I wrote this" }

### One reader, again and again: watch RateLimit count down
# @name again
GET {{base}}/feed?limit=1
Authorization: Bearer seed-token-42

### The account that hammered us asks for its feed
# @name hammered
GET {{base}}/feed?limit=1
Authorization: Bearer seed-token-16726

### A reader asks for an empty page: all we want is the headers
# @name counted
GET {{base}}/feed?limit=1&cursor=1
Authorization: Bearer seed-token-42

### Somebody posts, while we take Redis away
# @name spare
POST {{base}}/posts
Authorization: Bearer seed-token-2000
Content-Type: application/json

{ "body": "is Redis there?" }

### Somebody likes the quiet account's post
# @name like
POST {{base}}/posts/{{quietPost.response.body.id}}/like
Authorization: Bearer seed-token-2000

### And takes the like back
# @name unlike
DELETE {{base}}/posts/{{quietPost.response.body.id}}/like
Authorization: Bearer seed-token-2000

### A like for a post that doesn't exist
# @name missing
POST {{base}}/posts/999999999/like
Authorization: Bearer seed-token-2000

### The top of that user's feed
# @name liked
GET {{base}}/feed?limit=1
Authorization: Bearer seed-token-2000

### A follower of the biggest account reads the top of their feed
# @name reader
GET {{base}}/feed?limit=1
Authorization: Bearer seed-token-739

### The quiet account's notifications, newest first
# @name inbox
GET {{base}}/notifications?limit=2
Authorization: Bearer seed-token-16726

### How many of them it hasn't seen
# @name unread
GET {{base}}/notifications/unread
Authorization: Bearer seed-token-16726

### It has seen everything up to the newest one
# @name seen
POST {{base}}/notifications/read
Authorization: Bearer seed-token-16726
Content-Type: application/json

{ "up_to": {{inbox.response.body.notifications[0].id}} }

### The biggest account looks at its bell
# @name bigUnread
GET {{base}}/notifications/unread
Authorization: Bearer seed-token-1

### And at its list
# @name bigInbox
GET {{base}}/notifications?limit=1
Authorization: Bearer seed-token-1

### Three more people like the quiet account's post
# @name like2
POST {{base}}/posts/{{quietPost.response.body.id}}/like
Authorization: Bearer seed-token-739

###
# @name like3
POST {{base}}/posts/{{quietPost.response.body.id}}/like
Authorization: Bearer seed-token-42

###
# @name like4
POST {{base}}/posts/{{quietPost.response.body.id}}/like
Authorization: Bearer seed-token-363

### An account with 966 followers posts: the biggest fan-out we still push
# @name widePost
POST {{base}}/posts
Authorization: Bearer seed-token-115
Content-Type: application/json

{ "body": "hello to all 966 of you" }

### Episode 16: the quiet account posts
# @name mine
POST {{base}}/posts
Authorization: Bearer seed-token-16726
Content-Type: application/json

{ "body": "did this make it?" }

### and looks at its own page right away, as itself
# @name myPage
GET {{base}}/users/user16726/posts
Authorization: Bearer seed-token-16726

### The same page, read by anybody else
# @name theirPage
GET {{base}}/users/user16726/posts
